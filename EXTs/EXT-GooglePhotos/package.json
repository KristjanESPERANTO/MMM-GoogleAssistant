{
  "name": "EXT-GooglePhotos",
  "version": "1.6.1",
  "description": "An embedded Google Photos Displayer on MagicMirror.",
  "homepage": "https://wiki.bugsounet.fr/en/EXT-GooglePhotos",
  "license": "MIT",
  "main": "EXT-GooglePhotos.js",
  "scripts": {
    "clean": "rm -rf node_modules package-lock.json",
    "dev": "cd installer && node dev.js",
    "dev:src": "cd installer && node src.js",
    "postinstall": "installer/postinstall.sh -m",
    "preinstall": "installer/preinstall.sh",
    "reset": "rm -f *.js && rm -f components/*.js && git reset --hard",
    "test:minify": "cd installer && node minify.js",
    "token": "installer/token.sh",
    "update": "installer/update.sh"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "google-auth-library": "^9.15.0",
    "mkdirp": "^3.0.1",
    "open": "^10.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "rev": "241215",
  "authors": [
    "eouia",
    "bugsounet <bugsounet@bugsounet.fr>"
  ]
}

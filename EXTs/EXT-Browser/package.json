  "license": "MIT",
  "author": "bugsounet",
  "main": "EXT-Browser.js",
  "scripts": {
    "clean": "rm -rf node_modules package-lock.json",
    "lint": "eslint *.js installer/*.js components/*.js --config eslint.config.js",

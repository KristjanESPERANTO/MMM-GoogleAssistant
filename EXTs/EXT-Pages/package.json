{
  "name": "EXT-Pages",
  "version": "3.5.0",
  "description": "allows you to have pages in your magic mirror",
  "homepage": "https://wiki.bugsounet.fr/en/EXT-Pages",
  "license": "MIT",
  "author": [
    "edward-shen",
    "bugsounet"
  ],
  "main": "EXT-Pages.js",
  "scripts": {
    "clean": "rm -rf node_modules",
    "dev": "cd installer && node dev.js",
    "dev:src": "cd installer && node src.js",
    "lint": "cd ../.. && npm run lint",
    "lint:fix": "cd ../.. && npm run lint:fix",
    "postinstall": "installer/postinstall.sh -m",
    "preinstall": "installer/preinstall.sh",
    "reset": "rm -f *.js",
    "test": "npm run lint",
    "test:minify": "cd installer && node minify.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "rev": "241225"
}

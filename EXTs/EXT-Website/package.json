  "author": "bugsounet",
  "main": "EXT-Website.js",
  "scripts": {
    "clean": "rm -rf node_modules",
    "dev": "cd installer && node dev.js",
    "dev:src": "cd installer && node src.js",
    "lint": "cd ../.. && npm run lint",
    "lint:fix": "cd ../.. && npm run lint:fix",
    "postinstall": "installer/postinstall.sh -r -m",
    "preinstall": "installer/preinstall.sh",
    "rebuild": "installer/rebuild.sh",
    "reset": "rm -rf *.js components/*.js website/tools/*.js website/config/EXT-*",
    "test": "npm run lint",
    "test:minify": "cd installer && node minify.js"
  },
  "dependencies": {
    "body-parser": "^1.20.3",
    "cookie-parser": "^1.4.7",
    "express-body-parser-error-handler": "^1.0.7",
    "express-rate-limit": "^7.4.1",
    "express-slow-down": "^2.0.3",
    "http-proxy-middleware": "^3.0.3",
    "jquery": "^3.7.1",
    "jsoneditor": "^10.1.2",
    "jsonwebtoken": "^9.0.2",
    "node-pty": "^1.0.0",
    "prompt": "^1.3.0",
    "semver": "^7.6.3",
    "stream": "^0.0.3",
    "swagger-ui-express": "^5.0.1",
    "tablesorter": "^2.32.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "engines": {
    "node": ">=20"
  },

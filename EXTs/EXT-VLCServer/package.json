{
  "name": "EXT-VLCServer",
  "version": "1.2.1",
  "description": "VLC Media Server plugin for MMM-GoogleAssistant",
  "homepage": "https://wiki.bugsounet.fr/en/EXT-VLCServer",
  "license": "MIT",
  "author": "bugsounet",
  "main": "EXT-VLCServer.js",
  "scripts": {
    "clean": "rm -rf node_modules",
    "dev": "cd installer && node dev.js",
    "dev:src": "cd installer && node src.js",
    "lint": "cd ../.. && npm run lint",
    "lint:fix": "cd ../.. && npm run lint:fix",
    "postinstall": "installer/postinstall.sh -m",
    "preinstall": "installer/preinstall.sh -d 'vlc'",
    "reset": "rm -f *.js",
    "test": "npm run lint",
    "test:minify": "cd installer && node minify.js"
  },
  "engines": {
    "node": ">=20"
  },

{
  "name": "MMM-GoogleAssistant",
  "version": "8.1.0",
  "description": "An embedded Google Assistant on MagicMirror.",
  "keywords": [
    "MMM-GoogleAssistant",
    "magic mirror",
    "module",
    "google assistant",
    "voice",
    "embedded",
    "assistant for device",
    "voice control",
    "smart home"
  ],
  "homepage": "https://wiki.bugsounet.fr/MMM-GoogleAssistant",
  "bugs": {
    "url": "https://www.bugsounet.fr"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bugsounet/MMM-GoogleAssistant"
  },
  "license": "MIT",
  "author": "bugsounet",
  "main": "MMM-GoogleAssistant.js",
  "scripts": {
    "clean": "rm -rf node_modules package-lock.json",
    "delete": "node installer/delete.js",
    "dev": "cd installer && node dev.js",
    "dev:src": "cd installer && node src.js",
    "lint": "eslint . --config eslint.config.mjs",
    "lint:fix": "eslint . --config eslint.config.mjs --fix",
    "list": "node installer/list.js",
    "postinstall": "installer/postinstall.sh -m",
    "preinstall": "installer/preinstall.sh -d 'pulseaudio python3 python3-pip python-is-python3 make build-essential'",
    "rebuild": "npm run clean && npm run reset && npm install",
    "refresh": "node installer/refresh.js",
    "register": "node installer/register.js",
    "reset": "rm -f *.js && rm -rf components && git reset --hard",
    "test": "npm run lint",
    "test:minify": "cd installer && node minify.js",
    "token": "installer/token.sh",
    "update": "installer/update.sh"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.4",
    "buscar.io": "^1.8.1",
    "cli-spinner": "^0.2.10",
    "esbuild": "^0.24.0",
    "glob": "^11.0.0",
    "google-auth-library": "^9.15.0",
    "html-entities": "^2.5.2",
    "mkdirp": "^3.0.1",
    "node-html-parser": "^6.1.13",
    "open": "^10.1.0",
    "pm2": "^5.4.3",
    "press-any-key": "^1.1.0",
    "protobufjs": "^7.4.0",
    "readline": "^1.3.0",
    "sweetalert2": "^11.14.5"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^2.11.0",
    "eslint": "^9.16.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-package-json": "^0.18.0"
  },
  "engines": {
    "node": ">=20"
  },
  "rev": "241203"
}
